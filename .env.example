# ============================================================
# 部署环境变量模板
# 使用方法：复制为 .env（已被 .gitignore 忽略，不会上传 git），
# 按实际环境填写。生产环境务必修改所有默认值！
# 文件编码必须是 UTF-8 无 BOM（Windows 记事本保存请选 UTF-8）
# ============================================================

# ---------- MySQL ----------
# root 超级用户密码（docker-compose 初始化用）
MYSQL_ROOT_PASSWORD=changeme
# 各微服务 JDBC 连接密码（当前应用以 root 连接，请与 MYSQL_ROOT_PASSWORD 保持一致）
MYSQL_PASSWORD=changeme

# ---------- Redis ----------
REDIS_PASSWORD=changeme

# ---------- JWT 签名密钥 ----------
# 所有服务共享同一密钥（网关校验 / 认证签发）。生产环境请改为 32 位以上随机字符串：
#   openssl rand -base64 48
JWT_SECRET=your-secret-key-change-in-production

# ---------- 阿里云 OSS ----------
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=campus-idle
OSS_ACCESS_KEY_ID=your-aliyun-access-key-id
OSS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret

# ---------- Nacos（认证已开启） ----------
# Nacos 认证开关（如遇兼容性问题可临时改为 false，生产建议保持 true）
NACOS_AUTH_ENABLE=true
# 服务连接 Nacos 使用的账号（与 Nacos 控制台账号一致；首次登录控制台后请修改）
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# Nacos 认证 token（base64 编码，解码后 >32 字节）。生产请改为随机值：
#   openssl rand -base64 48
NACOS_AUTH_TOKEN=Y2FtcHVzLWlkbGUtY2xvdWQtbmFjb3MtYXV0aC1zZWNyZXQta2V5LXByb2QtMjAyNg==

# ---------- 网关 CORS ----------
# 允许跨域访问网关的来源（逗号分隔）。同源部署（Nginx 托管前端 + 反代）通常无需跨域，
# 这里保留默认值；若前端与网关不同源，加入实际域名/IP
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173
